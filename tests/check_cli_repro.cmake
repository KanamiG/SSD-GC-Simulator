if(NOT DEFINED SSD_SIM)
    message(FATAL_ERROR "Missing SSD_SIM executable path")
endif()
set(args --blocks 10 --pages-per-block 8 --logical-pages 60 --writes 800
         --workload random --policy wear-aware --lambda 0.05 --seed 77)
execute_process(COMMAND "${SSD_SIM}" ${args} RESULT_VARIABLE first_status OUTPUT_VARIABLE first_output ERROR_VARIABLE first_error)
execute_process(COMMAND "${SSD_SIM}" ${args} RESULT_VARIABLE second_status OUTPUT_VARIABLE second_output ERROR_VARIABLE second_error)
if(NOT "${first_status}" STREQUAL "0" OR NOT "${second_status}" STREQUAL "0")
    message(FATAL_ERROR "CLI run failed: ${first_error} ${second_error}")
endif()
if(NOT first_output STREQUAL second_output)
    message(FATAL_ERROR "Same toolchain/seed did not reproduce identical CLI results")
endif()
message(STATUS "[PASS] CLI reproducible with same seed and toolchain")
